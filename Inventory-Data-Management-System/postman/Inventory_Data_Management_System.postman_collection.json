{
  "info": {
    "name": "Inventory Data Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": "REPLACE_WITH_PRODUCT_ID"
    }
  ],
  "item": [
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"sku\": \"WM-1001\",\n  \"category\": \"Electronics\",\n  \"price\": 799,\n  \"quantity\": 25,\n  \"reorderLevel\": 5,\n  \"supplier\": \"ABC Traders\"\n}"
        },
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products?page=1&limit=10"
      }
    },
    {
      "name": "Search and filter products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products?search=mouse&category=Electronics&minPrice=100&sort=-price&page=1&limit=10"
      }
    },
    {
      "name": "Get product by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Update product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 849,\n  \"reorderLevel\": 8\n}"
        },
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Adjust stock",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"change\": 10\n}"
        },
        "url": "{{baseUrl}}/api/products/{{productId}}/stock"
      }
    },
    {
      "name": "Low stock report",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/low-stock"
      }
    },
    {
      "name": "Category inventory summary",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/summary"
      }
    },
    {
      "name": "Delete product",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    }
  ]
}